# Gmail OAuth2 Credentials (Shared across all accounts)
# Get these from Google Cloud Console
# See README.md for detailed setup instructions

# OAuth2 Client ID from Google Cloud Console
GMAIL_CLIENT_ID=your_client_id_here.apps.googleusercontent.com

# OAuth2 Client Secret from Google Cloud Console  
GMAIL_CLIENT_SECRET=your_client_secret_here

# OAuth2 Setup: Port for temporary redirect server during token generation
# Used by get-refresh-token-desktop.ts (default: 8765)
# Change if port 8765 is already in use on your system
OAUTH_REDIRECT_PORT=8765

# Optional: Set log level (debug, info, warn, error)
# LOG_LEVEL=info